# 服务端口
PORT=3000
# JWT 密钥,生产环境必须是至少 32 字节的随机值
JWT_SECRET=
# 访客显示 ID 的 HMAC 盐;可选,默认复用 JWT_SECRET,生产环境显式配置时至少 32 字节
GUEST_ID_SALT=
# 显示 ID 禁止包含的 2-5 位 Base36 片段，支持数字、字母或混合内容，英文逗号分隔。
DISPLAY_ID_FORBIDDEN_TOKENS=
# Redis 地址;生产环境建议设置 REDIS_REQUIRED=true,连接失败则拒绝启动
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=csgofriberg:
REDIS_REQUIRED=false
# 请求路径上 Redis 操作的超时,避免 Redis 拥塞时挂起 HTTP 请求
REDIS_COMMAND_TIMEOUT_MS=1500
# 多实例争用同一房间时允许等待 Redis 锁的最长时间
ROOM_LOCK_WAIT_MS=1000
# PoW 默认约适合移动端亚秒级完成;允许范围 16-24 bit
POW_DIFFICULTY=17
# 注册使用更高难度的 PoW，默认比普通请求高 2 bit，移动端目标约 3 秒内完成。
POW_REGISTER_DIFFICULTY=19
POW_CHALLENGE_TTL_SECONDS=120
POW_TOKEN_TTL_SECONDS=600
# 允许访问 API 与 Socket.IO 的前端来源,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
CSP_IMAGE_ORIGINS=https://img.alicdn.com
# 仅在应用确实位于一层可信反向代理之后时启用；同时用于 HTTP 和 Socket.IO 真实 IP
TRUST_PROXY=false
# 数据库类型: sqlite | pg
DB_CLIENT=sqlite
# sqlite 时为文件路径;pg 时为连接串,如 postgres://user:pass@localhost:5432/csgofriberg
DB_URL=./data/csgofriberg.sqlite3
DB_POOL_MIN=2
DB_POOL_MAX=20
# 管理员通过 ADMIN_USERNAME/ADMIN_PASSWORD + pnpm create-admin 显式创建
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 性能与行为调优(以下均有默认值,通常无需改动)
# 管理员选手 JSON 导入请求体上限
ADMIN_IMPORT_BODY_LIMIT_BYTES=2097152
# 密码哈希 worker 线程池
PASSWORD_WORKERS=1
PASSWORD_QUEUE_LIMIT=64
# 哈希成本;既有不同成本的哈希会在下次登录成功后自动重新哈希
BCRYPT_ROUNDS=8
# 多人对战断线多久判负
DISCONNECT_FORFEIT_MS=30000
# 设为 false 隐藏排行榜入口并禁用排行榜 API
SHOW_LEADERBOARD=true

# 可选邮箱验证 SMTP。EMAIL_ALLOWED_SUFFIXES 为空表示不限制后缀；用逗号分隔。
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_ALLOWED_SUFFIXES=
EMAIL_VERIFY_TTL_SECONDS=1800
# GeeTest is required in production. The public ID is returned to the browser at runtime.
GEETEST_CAPTCHA_ID=
GEETEST_PRIVATE_KEY=
GEETEST_VALIDATE_URL=https://gcaptcha4.geetest.com/validate
GEETEST_TIMEOUT_MS=3000

# 可选的管理员按需作弊分析服务。URL 与 TOKEN 必须同时配置；留空时分析按钮返回未配置。
CHEAT_ANALYSIS_API_URL=
CHEAT_ANALYSIS_API_TOKEN=
CHEAT_ANALYSIS_TIMEOUT_MS=15000

# 留空即关闭 Umami 统计。站点 ID 可在 Umami 网站设置中获取。
UMAMI_WEBSITE_ID=
# 自托管 Umami 时改为对应的脚本完整地址。
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# 前端构建期变量(供参考):购买直达卡片的联盟转链服务。
# Vite 只读取 client/ 目录下的 .env 或 shell 环境变量,本文件对前端不生效;
# 不配置时使用 client/src/config/affiliate.ts 内置的默认值。
# VITE_AFFILIATE_SERVICE_URL=https://affiliate.gearclickist.com
# VITE_AFFILIATE_TOKEN=
